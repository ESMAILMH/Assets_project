<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssetTracking</RootNamespace>
    <AssemblyName>AssetTracking</AssemblyName>
    <Product>نظام حصر الأصول وتتبع العهد</Product>
    <Company>كلية التقنيات الهندسية - يفرن</Company>
    <Version>1.0.0</Version>
    <!-- يسمح ببناء المشروع من أي نظام، والتشغيل يكون على Windows 10 أو أحدث -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- ملفات المصمم (Designer) تُنشئ الحقول داخل InitializeComponent -->
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET provider for SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Excel: import, template and export -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- خط Cairo: يُنسخ مع البرنامج ويُثبَّت تلقائياً للمستخدم عند أول تشغيل -->
    <None Update="Fonts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
